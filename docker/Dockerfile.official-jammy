# Official-package OpenFOAM v2606 development image for cteasFOAM.
# No third-party OpenFOAM image and no OpenFOAM source compilation.
FROM ubuntu:22.04@sha256:0a9887931b0e38af2e3487ed39e29436b0535c4f3f52e57745baaf79d1898956

ARG DEBIAN_FRONTEND=noninteractive
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates curl gnupg \
      build-essential cmake pkg-config python3 \
      openmpi-bin libopenmpi-dev \
 && rm -rf /var/lib/apt/lists/*

# OpenCFD / Keysight package repository (not the Foundation repository).
# v2606 was formally released on 2026-06-26, but the official Jammy package
# filename still includes "~rc2-1" as of 2026-10-23. Keep the TESTED version.
ARG OPENFOAM_PACKAGE_VERSION=2606.0~rc2-1
RUN mkdir -p /etc/apt/keyrings \
 && curl --fail --show-error --silent --location \
       https://dl.openfoam.com/pubkey.gpg \
    | gpg --dearmor --output /etc/apt/keyrings/openfoam-com.gpg \
 && chmod 0644 /etc/apt/keyrings/openfoam-com.gpg \
 && echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/openfoam-com.gpg] https://dl.openfoam.com/repos/deb jammy main" \
      > /etc/apt/sources.list.d/openfoam-com.list \
 && apt-get update \
 && apt-cache policy openfoam2606 openfoam2606-dev openfoam2606-default \
 && apt-get install -y --no-install-recommends \
      "openfoam2606-default=${OPENFOAM_PACKAGE_VERSION}" \
      "openfoam2606-dev=${OPENFOAM_PACKAGE_VERSION}" \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
CMD ["/bin/bash"]
