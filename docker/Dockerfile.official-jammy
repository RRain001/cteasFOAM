# Official-package OpenFOAM v2606 development image for cteasFOAM.
# No third-party OpenFOAM image and no OpenFOAM source compilation.
# Pin the Ubuntu base digest and APT package versions after CI proves this works.
FROM ubuntu:22.04

ARG DEBIAN_FRONTEND=noninteractive
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates curl gnupg \
      build-essential cmake pkg-config \
      openmpi-bin libopenmpi-dev \
 && rm -rf /var/lib/apt/lists/*

# OpenCFD / Keysight package repository (not the Foundation repository).
# Import *only* the official repository key, and scope trust using signed-by.
RUN mkdir -p /etc/apt/keyrings \
 && curl --fail --show-error --silent --location \
       https://dl.openfoam.com/pubkey.gpg \
       --output /etc/apt/keyrings/openfoam-com.gpg \
 && echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/openfoam-com.gpg] https://dl.openfoam.com/repos/deb jammy main" \
      > /etc/apt/sources.list.d/openfoam-com.list \
 && apt-get update \
 && apt-cache policy openfoam2606 openfoam2606-dev openfoam2606-default \
 && apt-get install -y --no-install-recommends \
      openfoam2606-default openfoam2606-dev \
 && rm -rf /var/lib/apt/lists/*

# Environment is explicitly initialized by tests and runtime launcher scripts.
# Avoid a system-wide, implicitly-sourced bashrc.
WORKDIR /workspace
CMD ["/bin/bash"]
